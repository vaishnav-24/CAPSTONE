FLASK_ENV=development
SECRET_KEY=change-me-in-production

# Local dev uses SQLite by default if DATABASE_URL is empty.
DATABASE_URL=

# Example for Azure SQL (set in Azure App Service > Configuration):
# DATABASE_URL=mssql+pyodbc://<user>:<pwd>@<server>.database.windows.net:1433/<db>?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no

# Seed admin (used on first startup if no admin exists)
ADMIN_EMAIL=admin@shop.local
ADMIN_PASSWORD=changeme
